<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Как вы себя чувствуете?"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Оцените настроение:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/mood1"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 1"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 2"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 3"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 4"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood5"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 5"
            android:padding="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Комментарий:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/commentEditText"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:padding="12dp"
        android:hint="Введите ваш комментарий..."
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Очистить"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#F44336" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сохранить"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#4CAF50" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:background="#ffffff">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статистика за неделю"
            android:textSize="20dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пн"
        android:textSize="18dp"
        android:layout_marginLeft="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вт"
        android:textSize="18dp"
        android:layout_marginLeft="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ср"
            android:textSize="18dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Чт"
            android:textSize="18dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пт"
            android:textSize="18dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сб"
            android:textSize="18dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вс"
            android:textSize="18dp"
            android:layout_marginLeft="30dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

    <TextView
        android:id="@+id/pn"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#4CAF50"
        android:layout_marginLeft="10dp"
        android:text="4"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    <TextView
        android:id="@+id/vt"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#ffc107"
        android:layout_marginLeft="2dp"
        android:text="3"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    <TextView
        android:id="@+id/sr"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#4CAF50"
        android:layout_marginLeft="2dp"
        android:text="5"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center" />

    <TextView
        android:id="@+id/cht"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#ff9800"
        android:layout_marginLeft="2dp"
        android:text="2"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    <TextView
        android:id="@+id/pt"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#4CAF50"
        android:layout_marginLeft="2dp"
        android:text="4"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    <TextView
        android:id="@+id/sb"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#4CAF50"
        android:layout_marginLeft="2dp"
        android:text="5"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    <TextView
        android:id="@+id/vs"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:background="#4CAF50"
        android:layout_marginLeft="2dp"
        android:text="4"
        android:textSize="20dp"
        android:textColor="#FFFF"
        android:gravity="center"/>

    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Цвет показывает оценку настроения (1-5)"
        android:textSize="12dp"
        android:textColor="#666666"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:layout_gravity="center"/>
</LinearLayout>
</LinearLayout>
